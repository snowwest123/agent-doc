# ===== LLM (DashScope OpenAI-compatible mode) =====
# 千问 key，OpenAI 兼容模式直接当 OPENAI_API_KEY 用
OPENAI_API_KEY=your-dashscope-api-key

# DashScope 兼容端点
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认模型（可改 qwen-turbo / qwen-plus / qwen-max）
LLM_MODEL=qwen-plus

# 生成参数
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ===== Redis（容器内默认连 redis:6379）=====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ===== 持久化目录 =====
MYRAG_DATA_DIR=/app/data
MAX_UPLOAD_SIZE_BYTES=10485760

# ===== 向量库：faiss 或 hologres =====
VECTOR_STORE=faiss

# ===== Hologres VectorStore（VECTOR_STORE=hologres 时启用）=====
HOLOGRES_HOST=your-hologres-host
HOLOGRES_PORT=80
HOLOGRES_DB=your-database
HOLOGRES_USER=your-access-id
HOLOGRES_PASSWORD=your-access-key
HOLOGRES_VECTOR_TABLE=rag_chunks
HOLOGRES_VECTOR_DIM=1536
HOLOGRES_CONNECT_TIMEOUT=10

# ===== API Key（留空则不校验）=====
# MY_API_KEY=your-secret-key-here
